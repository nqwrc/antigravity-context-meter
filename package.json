{
  "name": "antigravity-context-meter",
  "displayName": "Antigravity Context Window Meter",
  "description": "Real-time context window usage meter and token tracker for Google Antigravity IDE with per-project scoping",
  "version": "1.0.0",
  "publisher": "nqwrc",
  "icon": "icon.png",
  "author": {
    "name": "Nicola Pandolfi"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nqwrc/antigravity-context-meter.git"
  },
  "homepage": "https://github.com/nqwrc/antigravity-context-meter#readme",
  "bugs": {
    "url": "https://github.com/nqwrc/antigravity-context-meter/issues"
  },
  "pricing": "Free",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "keywords": [
    "antigravity",
    "google antigravity",
    "gemini",
    "claude",
    "llm",
    "context window",
    "context-window",
    "token-counter",
    "token-meter",
    "tokens",
    "usage",
    "monitor",
    "ai-assistant",
    "status-bar"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "scripts": {
    "lint": "node -c extension.js",
    "test": "node test.js && node test-status-bar.js",
    "package": "npx --yes @vscode/vsce@4.0.0 package --readme-path README.marketplace.md"
  },
  "contributes": {
    "commands": [
      {
        "command": "antigravityContextMeter.showDetails",
        "title": "Antigravity: Show Context Window Details"
      },
      {
        "command": "antigravityContextMeter.refresh",
        "title": "Antigravity: Refresh Context Telemetry"
      },
      {
        "command": "antigravityContextMeter.openTranscript",
        "title": "Antigravity: Open Active Session Transcript"
      },
      {
        "command": "antigravityContextMeter.revealSessionFolder",
        "title": "Antigravity: Reveal Session Folder in OS File Manager"
      }
    ],
    "configuration": {
      "title": "Antigravity Context Meter",
      "properties": {
        "antigravityContextMeter.modelContextLimit": {
          "type": "number",
          "default": 1000000,
          "description": "Maximum context window tokens for the active model (default: 1,000,000 for Gemini 3.7 Flash)."
        },
        "antigravityContextMeter.refreshIntervalSeconds": {
          "type": "number",
          "default": 3,
          "description": "Interval in seconds to check for active conversation changes."
        },
        "antigravityContextMeter.warningThresholdPercent": {
          "type": "number",
          "default": 75,
          "description": "Context percentage threshold to display warning status color."
        }
      }
    }
  }
}
